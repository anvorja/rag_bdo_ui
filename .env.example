# Variables del panel (Vite). Todo lo que empieza por VITE_ queda PÚBLICO dentro del bundle:
# nunca pongas aquí claves, tokens ni contraseñas.
# Copia este archivo a .env (ignorado por git) y ajusta los valores.

# URL base de la API del asistente (repositorio enlaces-rag-bdo, carpeta api/)
VITE_API_URL=http://localhost:8000

# Nombre del banco que muestra el panel
VITE_NOMBRE_BANCO=Banco de Occidente
